    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Draft File",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/draft.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python Cli Add KB",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "cli",
                "--add-kb"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python Cli QA",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "cli",
                "--qa"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "server"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Agent Draft",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/chatagent.py",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Agent mrkl_chat.py",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/mrkl_chat.py",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}